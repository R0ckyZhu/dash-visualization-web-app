[Unit]
Description=DashViz web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashviz
Group=dashviz
WorkingDirectory=/opt/dashviz/current
EnvironmentFile=/etc/dashviz.env
Environment=PYTHONPATH=/opt/dashviz/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/dashviz
ExecStart=/opt/dashviz/venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/dashviz
StateDirectory=dashviz
UMask=0077

[Install]
WantedBy=multi-user.target
